{
  "name": "page-status-bar",
  "version": "0.1.0",
  "description": "Obsidian plugin: metadata status bar above body content for any typed page.",
  "private": true,
  "scripts": {
    "build": "node esbuild.config.mjs production && node deploy.mjs",
    "build:only": "node esbuild.config.mjs production",
    "deploy": "node deploy.mjs",
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.36.0",
    "@types/node": "^20.10.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.20.0",
    "obsidian": "^1.5.0",
    "tslib": "^2.6.0",
    "typescript": "^5.3.0"
  }
}
